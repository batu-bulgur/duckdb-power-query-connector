                normal=ts="1970-01-01T00:00:00.1234560" and pos="1970-01-01T00:00:00.1234560" and neg="1969-12-31T23:59:59.1234570",
                legacyTruncate=ts="1970-01-01T00:00:00.0001234" and pos="1970-01-01T00:00:00.0001234" and neg="1969-12-31T23:59:59.0001234",
                legacyRound=ts="1970-01-01T00:00:00.0001235" and pos="1970-01-01T00:00:00.0001235" and neg="1969-12-31T23:59:59.0001235"
