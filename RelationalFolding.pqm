    Wrap = (row) =>
        let base=row[Data],typ=Value.Type(base),ns=Record.FieldNames(Fields(typ)),
            order=List.First(List.Select(List.Transform({0..List.Count(ns)},each "__duckdb_pq_order_" & Text.From(_)),each not List.Contains(ns,_))),
            rowError=List.First(List.Select(List.Transform({0..List.Count(ns)},each "__duckdb_pq_error_" & Text.From(_)),each not List.Contains(ns,_))),
            parts=List.Select({Record.FieldOrDefault(row,"Catalog",null),Record.FieldOrDefault(row,"Schema",null),row[Item]},each _<>null and _<>""),
            sql="SELECT " & Columns(ns) & ", ROW_NUMBER() OVER () AS " & Q(order) & ", NULL::VARCHAR AS " & Q(rowError) & " FROM " & Text.Combine(List.Transform(parts,Q),"."),
