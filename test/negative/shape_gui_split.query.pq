let s=DuckDB.Contents("__DB_PATH__",null,true,false,"single",[custom_user_agent="shape-gui-negative"]),t=Table.SelectRows(s{[Item="gui_text_base"]}[Data],each [id]=16),a=Table.SplitColumn(t,"label",Splitter.SplitTextByDelimiter("--",QuoteStyle.None),{"part1","part2","part3"}),b=Table.SelectColumns(a,{"id","part1","part2","part3"}) in Table.TransformColumnTypes(b,{{"part1",type text},{"part2",type text},{"part3",type text}})
