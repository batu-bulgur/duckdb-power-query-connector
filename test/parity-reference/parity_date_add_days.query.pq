let t=#table(type table[id=number,d=nullable date],{{1,#date(1,1,1)},{2,#date(1,1,31)},{3,#date(1582,10,4)},{4,#date(1600,2,29)},{5,#date(1700,2,28)},{6,#date(1900,2,28)},{7,#date(2000,2,29)},{8,#date(2023,1,31)},{9,#date(2024,1,31)},{10,#date(2024,2,29)},{11,#date(9999,12,31)},{12,null}}) in Table.Sort(Table.SelectColumns(Table.AddColumn(Table.SelectRows(t,each [id]<>11),"value",each Date.AddDays([d],1),type nullable date),{"id","value"}),{{"id",Order.Ascending}})