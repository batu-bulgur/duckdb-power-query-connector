                    " FROM (" & s[Sql] & ") AS q" & (if List.IsEmpty(keys) then " HAVING COUNT(*)>0" else " GROUP BY " & Text.Combine(List.Transform(keys,each KeySql(s,_)) & NaNKey(s,keys),", ")),
                ordered="SELECT " & Columns(List.Transform(keys,each Physical(s,_)) & fresh & {s[RowError]}) & ", ROW_NUMBER() OVER (ORDER BY " & Q(s[RowError]) & " IS NULL, " & Q(s[Order]) & ") AS " & Q(s[Order]) & " FROM (" & sql & ") AS grouped"
            in if Text.Length(ordered)<0 then error "Invalid group plan." else @View(ClearIndex(s) & [Native=Table.Group(s[Native],keys,triples),Type=typ,Sql=ordered,Encodings=Record.SelectFields(s[Encodings],keys,MissingField.Ignore),Aliases=Record.FromList(List.Transform(keys,each Physical(s,_)) & fresh,keys & List.Transform(aggregates,each _[Name])),ValueTypes=Record.SelectFields(s[ValueTypes],keys,MissingField.Ignore) & Record.FromList(List.Transform(aggregates,each _[Type]),List.Transform(aggregates,each _[Name]))]),
