            catalog=Record.FieldOrDefault(row,"Catalog",null),schema=Record.FieldOrDefault(row,"Schema",null),
            metadataSql="SELECT column_name,data_type, TIMESTAMP '1970-01-01 00:00:00.123456' AS pq_timestamp, make_timestamp_ns(123456700) AS pq_ns_positive, make_timestamp_ns(-876543300) AS pq_ns_negative FROM duckdb_columns() WHERE table_name=" & L(row[Item]) & (if catalog=null or catalog="" then "" else " AND database_name=" & L(catalog)) & (if schema=null or schema="" then "" else " AND schema_name=" & L(schema)),
