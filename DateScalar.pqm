// Date arithmetic uses bounded day/month ordinals. ISO text retains M's seventh
// fractional digit and explicit offset instead of rounding through TIMESTAMP.
let
    Functions={Date.Year,Date.Month,Date.Day,Date.DayOfWeek,Date.AddDays,Date.AddMonths,Date.StartOfMonth,Date.EndOfMonth},
    S=(s)=>"'" & Text.Replace(s,"'","''") & "'",
    Kind=(t)=>if t=type null then null else if Type.Is(t,type nullable date) then "date" else if Type.Is(t,type nullable datetime) then "datetime" else if Type.Is(t,type nullable datetimezone) then "datetimezone" else null,
    TypeOf=(k)=>Record.Field([date=type nullable date,datetime=type nullable datetime,datetimezone=type nullable datetimezone],k),
    Literal=(v)=>if v is date then Date.ToText(v,[Format="yyyy-MM-dd",Culture="en-US"])
        else if v is datetime then DateTime.ToText(v,[Format="yyyy-MM-ddTHH:mm:ss.fffffff",Culture="en-US"])
        else DateTimeZone.ToText(v,[Format="yyyy-MM-ddTHH:mm:ss.fffffffzzz",Culture="en-US"]),
    Format=(node,render)=>
        let typ=Record.FieldOrDefault(node,"Type",type any),k=Kind(typ),v=render(node),literal=Record.FieldOrDefault(node,"TemporalLiteral",null),
            lookup=Record.FieldOrDefault(Value.Metadata(typ),"DuckDBSqlType",null),nativeType=if lookup=null then null else lookup(),
            policyLookup=Record.FieldOrDefault(Value.Metadata(typ),"DuckDBTimestampPolicy",null),policy=if policyLookup=null then "microseconds" else policyLookup(),
            zone="strftime(" & v & ",'%z')",
            nativeTime="CASE WHEN typeof(" & v & ")='TIMESTAMP_NS' THEN make_timestamp(epoch_ns(" & v & ")//1000) ELSE CAST(" & v & " AS TIMESTAMP) END",
            seconds="strftime(" & nativeTime & ",'%Y-%m-%dT%H:%M:%S')",
            micro="CAST(strftime(" & nativeTime & ",'%f') AS BIGINT)",
            fraction=if policy="microseconds" then "strftime(" & nativeTime & ",'%f')||'0'" else "lpad(CAST((" & micro & (if policy="legacy-round" then "+50" else "") & ")//100 AS VARCHAR),7,'0')"
        in if List.Contains({"TIMESTAMP WITH TIME ZONE","TIMESTAMPTZ"},nativeType) then error Error.Record("DuckDB.NativeTimezone","The native TIMESTAMPTZ source requires host timezone rules which the ODBC schema does not serialize.")
           else if literal<>null then S(literal) else if List.Contains({"date","datetime","datetimezone"},Record.FieldOrDefault(node,"Encoding",null)) then v
           else if k="date" then "CAST(" & v & " AS VARCHAR)"
           else if k="datetime" then "(" & seconds & "||'.'||" & fraction & ")"
           else if k="datetimezone" then "(" & seconds & "||'.'||" & fraction & "||substr(" & zone & ",1,3)||':'||substr(" & zone & ",4,2))"
           else "CAST(NULL AS VARCHAR)",
    Offset=(s)=>"(CASE WHEN substr(" & s & ",28,1)='-' THEN -1 ELSE 1 END*(CAST(substr(" & s & ",29,2) AS INTEGER)*60+CAST(substr(" & s & ",32,2) AS INTEGER)))",
    Key=(node,render)=>let s=Format(node,render),k=Kind(Record.FieldOrDefault(node,"Type",type any))
        in if k<>"datetimezone" then s else "(SELECT strftime(CAST(substr(s,1,19) AS TIMESTAMP)-" & Offset("s") & "*INTERVAL '1 minute','%Y-%m-%dT%H:%M:%S')||substr(s,20,8) FROM (SELECT " & s & " AS s) AS temporal_key)",
    Decode=(value,k)=>if k="date" then Date.FromText(value,[Format="yyyy-MM-dd",Culture="en-US"])
        else if k="datetime" then DateTime.FromText(value,[Format="yyyy-MM-ddTHH:mm:ss.fffffff",Culture="en-US"])
        else DateTimeZone.FromText(value,[Format="yyyy-MM-ddTHH:mm:ss.fffffffzzz",Culture="en-US"]),
    ErrorTemplates=List.Buffer({(try Date.Year(1))[Error],(try Date.AddDays(#date(9999,12,31),1))[Error],(try Date.AddDays(#datetime(9999,12,31,0,0,0),1))[Error],(try Date.DayOfWeek(#date(2024,1,1),7))[Error],(try Date.DayOfWeek(1))[Error]}),
    Compile=(ast,rowType,compile,render)=>
        let f=ast[Function][Value],args=ast[Arguments],input=compile(args{0}),inputType=Record.FieldOrDefault(input,"Type",type any),kind=Kind(inputType),outKind=if kind=null then "date" else kind,
            extract=List.Contains({Date.Year,Date.Month,Date.Day,Date.DayOfWeek},f),addition=f=Date.AddDays or f=Date.AddMonths,
            hasArg=List.Count(args)>1,arg=if hasArg then compile(args{1}) else [Kind="Literal",Value="NULL",Type=type null],
            argType=Record.FieldOrDefault(arg,"Type",type any),argNumber=Type.Is(argType,type nullable number),
            rawArg=Record.FieldOrDefault(arg,"RawValueSql",render(arg)),argValue=if Record.FieldOrDefault(arg,"Encoding",null)="number" then "CAST(" & rawArg & " AS DOUBLE)" else render(arg),
            firstDay=Number.Mod(7-Date.DayOfWeek(#date(2024,1,7)),7),
            base="SELECT " & Format(input,render) & " AS s, " & (if f=Date.DayOfWeek then "coalesce(" & argValue & "," & Text.From(firstDay,"en-US") & ")" else argValue) & " AS n",
            inputNull=if args{0}[Kind]="Constant" then (if args{0}[Value]=null then "TRUE" else "FALSE") else render(input) & " IS NULL",
            Err=(condition,message,detail,k)=>"CASE WHEN " & condition & " THEN CAST(to_json(struct_pack(m := " & S(message) & ",d := " & detail & ",k := " & (if k is record then k[Sql] else S(k)) & ")) AS VARCHAR) ELSE NULL END",
            inherited="coalesce(" & Record.FieldOrDefault(input,"ErrorSql","NULL") & "," & Record.FieldOrDefault(arg,"ErrorSql","NULL") & ")",
            numberKind=Record.FieldOrDefault(arg,"NumericKindSql","'double'"),
            exactInteger="(SELECT rtrim(digits,'0')='' OR scale<=0 OR length(digits)-length(rtrim(digits,'0'))>=scale FROM (SELECT replace(replace(mantissa,'-',''),'.','') AS digits, CASE WHEN contains(mantissa,'.') THEN length(split_part(mantissa,'.',2)) ELSE 0 END-exponent AS scale FROM (SELECT split_part(lower(v),'e',1) AS mantissa,coalesce(TRY_CAST(nullif(split_part(lower(v),'e',2),'') AS INTEGER),0) AS exponent FROM (SELECT " & rawArg & " AS v) AS raw_number) AS number_parts) AS integer_parts)",
            invalidNumber=if Record.FieldOrDefault(arg,"Encoding",null)="number" then "CASE WHEN " & numberKind & "='decimal' THEN NOT " & exactInteger & " OR n < -2147483648 OR n > 2147483647 ELSE NOT isfinite(n) OR n<>trunc(n) OR n < -2147483648 OR n > 2147483647 END" else "NOT isfinite(n) OR n<>trunc(n) OR n < -2147483648 OR n > 2147483647",
            numberError=Err(if f=Date.DayOfWeek then argValue & " IS NOT NULL AND (" & invalidNumber & ")" else invalidNumber,"The number is out of range of a 32 bit integer value.",if Record.FieldOrDefault(arg,"Encoding",null)="number" then rawArg else "CAST(n AS VARCHAR)",[Sql="CASE WHEN " & numberKind & "='decimal' THEN 'number' ELSE 'double' END"]),
            numericInput=Type.Is(inputType,type nullable number),
            badKind=if numericInput then [Sql="CASE WHEN " & Record.FieldOrDefault(input,"NumericKindSql","'double'") & "='decimal' THEN 'number' ELSE 'double' END"] else if Type.Is(inputType,type nullable time) then "m-time" else if Type.Is(inputType,type nullable binary) then "m-binary" else "json",
            badDetail=if numericInput then "CAST(" & Record.FieldOrDefault(input,"RawValueSql",render(input)) & " AS VARCHAR)" else if badKind="m-time" and args{0}[Kind]="Constant" then S(Time.ToText(args{0}[Value],[Format="HH:mm:ss.fffffff",Culture="en-US"])) else if badKind="m-time" then "CAST(" & render(input) & " AS VARCHAR)" else if badKind="m-binary" then "hex(" & render(input) & ")" else "CAST(to_json(" & render(input) & ") AS VARCHAR)",
            inputError=if kind<>null or inputType=type null then "NULL" else Err("NOT (" & inputNull & ")",if f=Date.DayOfWeek then "We expected a Date value with a Days part." else "The Date value must contain the Date component.",badDetail,badKind),
            parsed="SELECT *, TRY_CAST(substr(s,1,10) AS DATE) AS d FROM (" & base & ") AS date_input",
            ordinal=if f=Date.AddDays then "date_diff('day',DATE '0001-01-01',d)+CAST(n AS DOUBLE)" else "(year(d)-1)*12+month(d)-1+CAST(n AS DOUBLE)",
            maxOrdinal=if f=Date.AddDays then "3652058" else "119987",
            numbered="SELECT *, " & (if addition then ordinal else "0") & " AS target FROM (" & parsed & ") AS date_parts",
            bounds="SELECT *, CASE WHEN isfinite(target) AND target BETWEEN 0 AND " & maxOrdinal & " THEN TRY_CAST(trunc(target) AS BIGINT) ELSE 0 END AS safe_target FROM (" & numbered & ") AS date_bounds",
            newDate=if f=Date.AddDays then "DATE '0001-01-01'+CAST(safe_target AS INTEGER)"
                else if f=Date.AddMonths then "make_date(CAST(safe_target//12+1 AS BIGINT),CAST(safe_target%12+1 AS BIGINT),CAST(least(day(d),day(last_day(make_date(CAST(safe_target//12+1 AS BIGINT),CAST(safe_target%12+1 AS BIGINT),1)))) AS BIGINT))"
                else if f=Date.StartOfMonth then "CAST(date_trunc('month',d) AS DATE)" else if f=Date.EndOfMonth then "last_day(d)" else "d",
            calculated="SELECT *, " & newDate & " AS result_date FROM (" & bounds & ") AS date_result",
            dateError=if addition then Err("NOT (target BETWEEN 0 AND " & maxOrdinal & ")","The " & (if kind="datetime" then "DateTime" else "Date") & " operation failed because the resulting value falls outside the range of allowed values.","NULL","none") else "NULL",
            argError=if addition or f=Date.DayOfWeek then numberError else "NULL",
            dayError=if f=Date.DayOfWeek then Err("n NOT BETWEEN 0 AND 6","The Day value provided is invalid.","CAST(n AS VARCHAR)","double") else "NULL",
            nullNumber=if addition then Err(argValue & " IS NULL","We cannot convert the value null to type Number.","NULL","null-number") else "NULL",
            err="coalesce(" & inherited & "," & nullNumber & "," & (if f=Date.DayOfWeek then "CASE WHEN " & inputNull & " THEN NULL ELSE coalesce(" & argError & "," & dayError & "," & inputError & ") END" else inputError & ",CASE WHEN " & inputNull & " THEN NULL ELSE coalesce(" & argError & "," & dateError & ") END") & ")",
            clock=if kind="date" or kind=null then "''" else if f=Date.StartOfMonth then S("T00:00:00.0000000") else if f=Date.EndOfMonth then S("T23:59:59.9999999") else "substr(s,11,17)",
            zone=if kind="datetimezone" then "substr(s,28,6)" else "''",
            temporal="CAST(result_date AS VARCHAR)||" & clock & "||" & zone,
            zoneOrdinal="date_diff('day',DATE '0001-01-01',result_date)*86400::BIGINT+" & (if f=Date.EndOfMonth then "86399" else if f=Date.StartOfMonth then "0" else "hour(CAST(substr(s,12,8) AS TIME))*3600+minute(CAST(substr(s,12,8) AS TIME))*60+second(CAST(substr(s,12,8) AS TIME))") & "-" & Offset("s") & "*60",
            zoneGuard=if kind="datetimezone" and not extract then "WHEN " & zoneOrdinal & " NOT BETWEEN 0 AND 315537897599 THEN error('Power Query throws an uncatchable CLR UTC-offset range exception for this date result.') " else "",
            value=if f=Date.Year then "year(d)" else if f=Date.Month then "month(d)" else if f=Date.Day then "day(d)" else if f=Date.DayOfWeek then "((CAST(date_part('dow',d) AS BIGINT)-CAST(n AS BIGINT)+7)%7)" else temporal,
            safeValue="CASE WHEN " & inputNull & " OR " & err & " IS NOT NULL THEN NULL " & zoneGuard & "ELSE " & value & " END",
            outputType=if extract then type nullable number else if inputType=type null then type null else if kind=null then type any else TypeOf(kind)
        in if hasArg and not argNumber then error "M validates a nonnumeric date-operation argument."
           else [Kind="Literal",Value="(SELECT " & safeValue & " FROM (" & calculated & ") AS date_value)",Type=outputType,Encoding=if extract then "normal" else outKind,Transport=true,ErrorSql="(SELECT " & err & " FROM (" & calculated & ") AS date_error)"]
in [Functions=Functions,Kind=Kind,Literal=Literal,Format=Format,Key=Key,Decode=Decode,Compile=Compile,ErrorTemplates=ErrorTemplates]
