let s=DuckDB.Contents("__DB_PATH__",null,true,false,"single",[custom_user_agent="shape-pipeline"]),t=Table.SelectRows(s{[Item="gui_text_base"]}[Data],each [id]=1),a=Table.TransformColumns(t,{{"label",each Text.Start(_,2),type nullable text}}),b=Table.ReplaceValue(a,"a","X",Replacer.ReplaceText,{"label"}),c=Table.CombineColumns(b,{"label","other_label"},Combiner.CombineTextByDelimiter("|",QuoteStyle.None),"merged") in Table.TransformColumnTypes(Table.SelectColumns(c,{"id","merged"}),{{"merged",type text}})