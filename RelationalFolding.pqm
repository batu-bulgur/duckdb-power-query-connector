// ODBC remains the transport. This view retains an ordered SQL plan for table
// operations which cannot be represented by scalar ODBC invocation overrides.
(connection, navigation as table, scalarVisitor as record, advancedScalar as function, roundScalar as function, equalityScalar as function, indexSql as function, dateScalar as record) as table =>
let
    Q = (s as text) => """" & Text.Replace(s, """", """""") & """",
    L = (v) =>
        if v = null then "NULL" else if v is text then "'" & Text.Replace(v,"'","''") & "'"
        else if v is logical then (if v then "TRUE" else "FALSE")
        else if v is number then
            if Number.IsNaN(v) then "'NaN'::DOUBLE"
            else if v = #infinity then "'Infinity'::DOUBLE" else if v = -#infinity then "'-Infinity'::DOUBLE"
            else Number.ToText(v,"R","en-US")
        else if v is date then "DATE '" & Date.ToText(v,[Format="yyyy-MM-dd",Culture="en-US"]) & "'"
        else if v is datetime then "TIMESTAMP '" & DateTime.ToText(v,[Format="yyyy-MM-dd HH:mm:ss.fffffff",Culture="en-US"]) & "'"
        else if v is datetimezone then "TIMESTAMPTZ '" & DateTimeZone.ToText(v,[Format="yyyy-MM-ddTHH:mm:ss.fffffffzzz",Culture="en-US"]) & "'"
        else if v is time then "TIME '" & Time.ToText(v,[Format="HH:mm:ss.fffffff",Culture="en-US"]) & "'"
        else if v is binary then "from_hex('" & Binary.ToText(v,BinaryEncoding.Hex) & "')"
        else if v is duration then "INTERVAL '" & Number.ToText(Duration.TotalSeconds(v),"R","en-US") & " seconds'"
        else error "Unsupported SQL literal type.",
    Fields = (t) => Type.RecordFields(Type.TableRow(t)),
    RowType = (s) => let fields=Fields(s[Type]) in Type.ForRecord(Record.TransformFields(fields,List.Transform(Record.FieldNames(fields),(n)=>{n,(d)=>if Record.HasFields(s[ValueTypes],n) then d & [Type=Record.Field(s[ValueTypes],n)] else d})),false),
    Names = (s) => Record.FieldNames(Fields(s[Type])),
    Columns = (names) => Text.Combine(List.Transform(names,Q),", "),
    Physical = (s,n) => Record.FieldOrDefault(s[Aliases],n,n),
    PhysicalNames = (s) => List.Transform(Names(s),each Physical(s,_)),
    NewAlias = (s) => List.First(List.Select(List.Transform({0..List.Count(Names(s))+1},each "__pq_column_" & Text.From(_)),each not List.Contains(PhysicalNames(s) & {s[Order]},_,Comparer.OrdinalIgnoreCase))),
    ClearIndex = (s) => Record.RemoveFields(s,{"PendingIndex"},MissingField.Ignore),
    UnitsSql = (sql) => "CASE WHEN " & sql & " IS NULL THEN NULL ELSE flatten(list_transform(list_filter(string_split(" & sql & ",''), c -> c<>''), c -> CASE WHEN unicode(c)>65535 THEN [55296+((unicode(c)-65536)//1024),56320+((unicode(c)-65536)%1024)] ELSE [unicode(c)] END)) END",
    ColumnValue = (s,n) => if Record.HasFields(s[Encodings],n) then "(" & Q(Physical(s,n)) & ").v" else Q(Physical(s,n)),
    NumericField = (s,n) => Type.Is(Record.Field(Type.RecordFields(RowType(s)),n)[Type],type nullable number),
    KeySql = (s,n) => let typ=Record.Field(Type.RecordFields(RowType(s)),n)[Type] in if NumericField(s,n) then "CAST(" & ColumnValue(s,n) & " AS DOUBLE)" else if dateScalar[Kind](typ)<>null then dateScalar[Key]([Value=ColumnValue(s,n),Type=typ,Encoding=Record.FieldOrDefault(s[Encodings],n,null)],each _[Value]) else ColumnValue(s,n),
    NaNKey = (s,keys) => let numbers=List.Select(keys,each NumericField(s,_))
        in if List.IsEmpty(numbers) then {} else {"CASE WHEN " & Text.Combine(List.Transform(numbers,each "isnan(" & KeySql(s,_) & ")")," OR ") & " THEN " & Q(s[Order]) & " ELSE 0 END"},
    InvalidUtf16 = (v) => v is text and (Text.Contains(v,Character.FromNumber(0)) or Text.FromBinary(Text.ToBinary(v,TextEncoding.Unicode),TextEncoding.Unicode)<>v),
    LiteralUnits = (t) => "[" & Text.Combine(List.Transform(Text.ToList(t),(c)=>let n=try Character.ToNumber(c),b=if n[HasError] then Binary.ToList(Binary.FromText(Text.Range(Text.FromBinary(Json.FromValue(c)),3,4),BinaryEncoding.Hex)) else null in Text.From(if n[HasError] then b{0}*256+b{1} else n[Value],"en-US")),",") & "]::BIGINT[]",
    Op = (name) => Record.Field([Equals="=",NotEqualTo="<>",GreaterThan=">",LessThan="<",GreaterThanOrEqual=">=",LessThanOrEqual="<=",And="AND",Or="OR"],name),
    Render = (a) =>
        if a = null then "" else
        let k=a[Kind] in
        if k="Literal" then a[Value]
        else if k="Column" then "q." & Q(a[Name])
        else if k="Invocation" then a[Function][Name] & "(" & Text.Combine(List.Transform(a[Arguments],each @Render(_[Expression])),", ") & ")"
        else if k="Cast" then "CAST(" & @Render(a[Expression]) & " AS " & (if a[Type] is text then a[Type] else error "SQL cast needs a native type name.") & ")"
        else if k="BinaryLogicalOperation" or k="ConditionOperation" then "(" & @Render(a[Left]) & " " & Op(a[Operator]) & " " & @Render(a[Right]) & ")"
        else if k="UnaryLogicalOperation" then
            if a[Operator] is record then "(" & @Render(a[Expression]) & ")"
            else "(" & @Render(a[Expression]) & " " & Record.Field([IsNull="IS NULL",IsNotNull="IS NOT NULL"],a[Operator]) & ")"
        else if k="Case" then "(CASE " & Text.Combine(List.Transform(a[Conditions],each "WHEN " & @Render(_[When]) & " THEN " & @Render(_[Then]))," ") & " ELSE " & @Render(a[Else]) & " END)"
        else error "Unsupported SQL AST node.",
    Node = (sql) => [Kind="Literal",Value=sql],
    ConstantNumberKind = (v) => try (if Value.Equals(v,Number.FromText(Number.ToText(v,"R","en-US"),"en-US"),Precision.Decimal) then "'decimal'" else "'double'") otherwise "'double'",
    ScalarKind = (n) => let t=Record.FieldOrDefault(n,"Type",type any) in if t=type null then "null" else if Type.Is(t,type nullable number) then "number" else if Type.Is(t,type nullable text) then "text" else if Type.Is(t,type nullable logical) then "logical" else if Type.Is(t,type nullable date) then "date" else if Type.Is(t,type nullable datetime) then "datetime" else if Type.Is(t,type nullable time) then "time" else if Type.Is(t,type nullable datetimezone) then "datetimezone" else "unknown",
    Compile = (a, rowType, encodings, aliases) =>
        let k=a[Kind] in
        if k="Constant" then if InvalidUtf16(a[Value]) then Node(LiteralUnits(a[Value])) & [Type=type text,Encoding="utf16",Transport=true,ErrorSql="NULL"] else Node(L(a[Value])) & [Type=Value.Type(a[Value])] & (if a[Value] is number then [NumericKindSql=ConstantNumberKind(a[Value])] else if dateScalar[Kind](Value.Type(a[Value]))<>null then [TemporalLiteral=dateScalar[Literal](a[Value])] else [])
        else if k="FieldAccess" then
            if Record.HasFields(encodings,a[MemberName]) then
                let physical=Record.FieldOrDefault(aliases,a[MemberName],a[MemberName]),raw="(q." & Q(physical) & ").v",encoding=Record.Field(encodings,a[MemberName])
                in [Kind="Literal",Value=if encoding="number" then "CAST(" & raw & " AS DOUBLE)" else raw,RawValueSql=raw,NumericKindSql="(q." & Q(physical) & ").k",Type=if encoding="number" then type nullable number else if encoding="utf16" then type nullable text else if encoding="logical" then type nullable logical else if encoding="list" then type list else Record.Field(Type.RecordFields(rowType),a[MemberName])[Type],Encoding=encoding,ErrorSql="(q." & Q(physical) & ").e",Transport=true]
            else let typ=Record.Field(Type.RecordFields(rowType),a[MemberName])[Type],facets=Type.Facets(typ),precision=Record.FieldOrDefault(facets,"NumericPrecision",null),scale=Record.FieldOrDefault(facets,"NumericScale",null),
                    column="q." & Q(Record.FieldOrDefault(aliases,a[MemberName],a[MemberName])),nativeType=Record.FieldOrDefault(facets,"NativeTypeName",null)
                in if nativeType="BOOLEAN" then Node("CAST(" & column & " AS VARCHAR)") & [Type=type nullable text,Transport=true,ErrorSql="NULL"]
                   else if nativeType="TIME" then Node("CAST(substr(CAST(" & column & " AS VARCHAR),1,8) AS TIME)") & [Type=typ,Transport=true,ErrorSql="NULL"]
                   else [Kind="Column",Name=Record.FieldOrDefault(aliases,a[MemberName],a[MemberName]),Type=typ,NumericKindSql=if nativeType="UBIGINT" then "'decimal'" else if List.Contains({24,53},precision) or scale=null then "'double'" else "'decimal'"]
        else if k="Binary" then
            let left=@Compile(a[Left],rowType,encodings,aliases),right=@Compile(a[Right],rowType,encodings,aliases),
                op=Record.Field([Add="+",Subtract="-",Multiply="*",Divide="/",Equals="IS NOT DISTINCT FROM",NotEquals="IS DISTINCT FROM",LessThan="<",GreaterThan=">",LessThanOrEquals="<=",GreaterThanOrEquals=">=",And="AND",Or="OR"],a[Operator]),
                numeric=Type.Is(Record.FieldOrDefault(left,"Type",type any),type nullable number) and Type.Is(Record.FieldOrDefault(right,"Type",type any),type nullable number),
                textual=Type.Is(Record.FieldOrDefault(left,"Type",type any),type nullable text) and Type.Is(Record.FieldOrDefault(right,"Type",type any),type nullable text),
                temporal=dateScalar[Kind](Record.FieldOrDefault(left,"Type",type any))<>null and dateScalar[Kind](Record.FieldOrDefault(left,"Type",type any))=dateScalar[Kind](Record.FieldOrDefault(right,"Type",type any)),
                ValueSql=(n)=>if numeric then "CAST(" & Render(n) & " AS DOUBLE)" else if temporal then dateScalar[Key](n,Render) else if textual and Record.FieldOrDefault(n,"Encoding",null)<>"utf16" then UnitsSql(Render(n)) else Render(n),
                l=ValueSql(left),r=ValueSql(right),arithmetic=List.Contains({"Add","Subtract","Multiply","Divide"},a[Operator]),
                ordinary="(" & l & " " & op & " " & r & ")",
                equality=if a[Operator]="Equals" then "(" & ordinary & " AND NOT (coalesce(isnan(" & l & "),false) OR coalesce(isnan(" & r & "),false)))"
                         else "(" & ordinary & " OR coalesce(isnan(" & l & "),false) OR coalesce(isnan(" & r & "),false))",
                ordered=if a[Operator]="LessThan" then "CASE WHEN isnan(" & r & ") THEN FALSE WHEN isnan(" & l & ") THEN TRUE ELSE " & ordinary & " END"
                    else if a[Operator]="GreaterThan" then "CASE WHEN isnan(" & l & ") THEN FALSE WHEN isnan(" & r & ") THEN TRUE ELSE " & ordinary & " END"
                    else if a[Operator]="LessThanOrEquals" then "CASE WHEN isnan(" & l & ") THEN TRUE WHEN isnan(" & r & ") THEN FALSE ELSE " & ordinary & " END"
                    else "CASE WHEN isnan(" & r & ") THEN TRUE WHEN isnan(" & l & ") THEN FALSE ELSE " & ordinary & " END",
                mismatch=not List.Contains({"null","unknown"},ScalarKind(left)) and not List.Contains({"null","unknown"},ScalarKind(right)) and ScalarKind(left)<>ScalarKind(right),
                nullEqual="(" & Render(left) & " IS NULL AND " & Render(right) & " IS NULL)",
                sql=if mismatch and a[Operator]="Equals" then nullEqual else if mismatch and a[Operator]="NotEquals" then "NOT " & nullEqual
                    else if numeric and List.Contains({"Equals","NotEquals"},a[Operator]) then equality
                    else if numeric and List.Contains({"LessThan","GreaterThan","LessThanOrEquals","GreaterThanOrEquals"},a[Operator]) then "CASE WHEN " & l & " IS NULL OR " & r & " IS NULL THEN NULL ELSE " & ordered & " END"
                    else ordinary,
                rightError=Record.FieldOrDefault(right,"ErrorSql","NULL"),
                branchError=if a[Operator]="And" then "CASE WHEN " & l & "=FALSE THEN NULL ELSE " & rightError & " END" else if a[Operator]="Or" then "CASE WHEN " & l & "=TRUE THEN NULL ELSE " & rightError & " END" else rightError
            in Node(sql) & [Type=if arithmetic then type nullable number else type nullable logical,NumericKindSql=if arithmetic then "'double'" else "NULL",Transport=Record.FieldOrDefault(left,"Transport",false) or Record.FieldOrDefault(right,"Transport",false),ErrorSql="coalesce(" & Record.FieldOrDefault(left,"ErrorSql","NULL") & "," & branchError & ")"]
        else if k="Unary" then
            let inner=@Compile(a[Expression],rowType,encodings,aliases),encoded=Record.FieldOrDefault(inner,"Encoding",null)="number",raw=Record.FieldOrDefault(inner,"RawValueSql",Render(inner)),
                kind=Record.FieldOrDefault(inner,"NumericKindSql","'double'"),
                negative="CASE WHEN " & kind & "='decimal' THEN CASE WHEN starts_with(" & raw & ",'-') THEN substr(" & raw & ",2) ELSE '-'||" & raw & " END ELSE CAST(-CAST(" & raw & " AS DOUBLE) AS VARCHAR) END"
            in (if a[Operator]="Not" then Node("(NOT " & Render(inner) & ")") & [Type=type nullable logical]
                else if encoded then Node(negative) & [Type=type nullable number,Encoding="number",RawValueSql=negative,NumericKindSql=kind]
                else Node("(-" & Render(inner) & ")") & [Type=type nullable number,NumericKindSql=kind]) & [Transport=Record.FieldOrDefault(inner,"Transport",false),ErrorSql=Record.FieldOrDefault(inner,"ErrorSql","NULL")]
        else if k="If" then
            let condition=@Compile(a[Condition],rowType,encodings,aliases),yes=@Compile(a[TrueCase],rowType,encodings,aliases),no=@Compile(a[FalseCase],rowType,encodings,aliases),
                c=Render(condition),yt=Record.FieldOrDefault(yes,"Type",type any),nt=Record.FieldOrDefault(no,"Type",type any),
                number=Type.Is(yt,type nullable number) and Type.Is(nt,type nullable number),text=Type.Is(yt,type nullable text) and Type.Is(nt,type nullable text),logical=Type.Is(yt,type nullable logical) and Type.Is(nt,type nullable logical),
                temporalKind=if dateScalar[Kind](yt)=null then dateScalar[Kind](nt) else dateScalar[Kind](yt),
                temporal=temporalKind<>null and (yt=type null or dateScalar[Kind](yt)=temporalKind) and (nt=type null or dateScalar[Kind](nt)=temporalKind),
                BranchValue=(n)=>if number then (if Record.FieldOrDefault(n,"Encoding",null)="number" then Record.FieldOrDefault(n,"RawValueSql",Render(n)) else "CAST(" & Render(n) & " AS VARCHAR)") else if temporal then dateScalar[Format](n,Render) else if text and Record.FieldOrDefault(n,"Encoding",null)<>"utf16" then UnitsSql(Render(n)) else Render(n),
                value="(CASE WHEN " & c & " THEN " & BranchValue(yes) & " ELSE " & BranchValue(no) & " END)",
                err="coalesce(" & Record.FieldOrDefault(condition,"ErrorSql","NULL") & ", CASE WHEN " & c & " IS NULL THEN CAST(to_json(struct_pack(m := 'We cannot convert the value null to type Logical.',d := NULL,k := 'null-logical')) AS VARCHAR) WHEN " & c & " THEN " & Record.FieldOrDefault(yes,"ErrorSql","NULL") & " ELSE " & Record.FieldOrDefault(no,"ErrorSql","NULL") & " END)"
            in if not Type.Is(Record.FieldOrDefault(condition,"Type",type any),type nullable logical) then error "An M conditional requires a logical condition."
                else if not (number or text or logical or temporal) then error "The conditional branches need a common SQL value representation."
                else Node(value) & [Type=if number then type nullable number else if text then type nullable text else if temporal then Record.Field([date=type nullable date,datetime=type nullable datetime,datetimezone=type nullable datetimezone],temporalKind) else type nullable logical,Encoding=if number then "number" else if text then "utf16" else if temporal then temporalKind else "logical",RawValueSql=value,NumericKindSql="CASE WHEN " & c & " THEN " & Record.FieldOrDefault(yes,"NumericKindSql","'double'") & " ELSE " & Record.FieldOrDefault(no,"NumericKindSql","'double'") & " END",ErrorSql=err,Transport=true]
        else if k="Invocation" then
            let f=a[Function][Value], visitor=(e)=>@Compile(e,rowType,encodings,aliases),
                encoded=List.AnyTrue(List.Transform(a[Arguments],each if _[Kind]="Constant" then false else Record.FieldOrDefault(visitor(_),"Transport",false))),
                texts={Text.EndsWith,Text.Length,Text.Middle,Text.Range,Text.PositionOf,Text.PadStart,Text.PadEnd,Text.Trim,Text.TrimStart,Text.TrimEnd}
            in
            if f=Value.Equals or f=Value.NullableEquals then equalityScalar(a,rowType,visitor,Render,roundScalar,dateScalar)
            else if List.Contains(dateScalar[Functions],f) then dateScalar[Compile](a,rowType,visitor,Render)
            else if f=Number.Round then roundScalar(a,rowType,visitor,Render)
            // Keep the native ODBC planner's existing literal Contains/StartsWith
            // filters available, and retain their SQL when an index follows.
            else if List.Contains({Text.Contains,Text.StartsWith},f) and List.Count(a[Arguments])=2 and not encoded
                and a[Arguments]{1}[Kind]="Constant" and a[Arguments]{1}[Value] is text and not InvalidUtf16(a[Arguments]{1}[Value]) then
                Node((if f=Text.Contains then "contains" else "starts_with") & "(" & Render(visitor(a[Arguments]{0})) & "," & Render(visitor(a[Arguments]{1})) & ")") & [Type=type nullable logical]
            else if List.Contains(texts,f) and (HasAdvanced(a) or encoded) then advancedScalar(a,rowType,visitor,Render)
            else if List.Contains(scalarVisitor[Functions],f) then scalarVisitor[Invocation](visitor,rowType,{},a)
            else if f=List.Sum then Node("SUM(" & Render(visitor(a[Arguments]{0})) & ")")
            else if List.Contains({List.Min,List.Max,List.Average},f) then Node((if f=List.Min then "MIN" else if f=List.Max then "MAX" else "AVG") & "(" & Render(visitor(a[Arguments]{0})) & ")")
            else if f=Table.RowCount then Node("COUNT(*)")
            else error "Unsupported M invocation in relational expression."
        else error "Unsupported M expression in relational plan.",
    Expr = (fn,s) => Compile(RowExpression.From(fn),RowType(s),s[Encodings],s[Aliases]),
    HasAdvanced = (a) =>
        if a[Kind]="Invocation" then
            let f=a[Function][Value] in
            (List.Contains({Text.Middle,Text.Range,Number.Round,Value.Equals,Value.NullableEquals},f)) or List.Contains(dateScalar[Functions],f)
            or (f=Text.PositionOf and List.Count(a[Arguments])>2)
            or (f=Text.EndsWith and List.Count(a[Arguments])>2)
            or (List.Contains({Text.EndsWith,Text.Length,Text.PositionOf},f) and List.AnyTrue(List.Transform(a[Arguments],each _[Kind]="Constant" and InvalidUtf16(_[Value]))))
            or List.Contains({Text.PadStart,Text.PadEnd,Text.Trim,Text.TrimStart,Text.TrimEnd},f)
            or List.AnyTrue(List.Transform(a[Arguments],each @HasAdvanced(_)))
        else if a[Kind]="Binary" then @HasAdvanced(a[Left]) or @HasAdvanced(a[Right])
        else false,
    NativeError=(fn)=>(try fn())[Error],
    ErrorTemplates=List.Buffer({NativeError(()=>Text.Middle("x",-1)),NativeError(()=>Text.Range("x",2)),NativeError(()=>Text.Range("x",0,2)),
        NativeError(()=>Text.Middle("x",1.5)),NativeError(()=>Text.Middle("x",null)),NativeError(()=>Text.PositionOf(null,"x")),
        NativeError(()=>Text.PadStart("x",3,"xx")),NativeError(()=>Number.Round(1.25,1,99)),NativeError(()=>Value.Equals(1,1,99)),NativeError(()=>Value.Equals(#infinity,1,Precision.Decimal)),NativeError(()=>if null then 1 else 2)} & dateScalar[ErrorTemplates]),
    RestoreError=(text)=>
        let parsed=try Json.Document(text),payload=if parsed[HasError] then [m=text,d=null,k=null] else parsed[Value],
            matches=List.Select(ErrorTemplates,each _[Message]=payload[m]),
            detail=if payload[k]="number" then if Text.Lower(payload[d])="nan" then #nan else if List.Contains({"inf","infinity"},Text.Lower(payload[d])) then #infinity else if List.Contains({"-inf","-infinity"},Text.Lower(payload[d])) then -#infinity else Number.FromText(payload[d],"en-US")
                else if payload[k]="double" then if Text.Lower(payload[d])="nan" then #nan else if Text.Lower(payload[d])="inf" then #infinity else if Text.Lower(payload[d])="-inf" then -#infinity else Double.From(payload[d],"en-US")
                else if payload[k]="null-number" then [Value=null,Type=type number]
                else if payload[k]="null-text" then [Value=null,Type=type text]
                else if payload[k]="null-logical" then [Value=null,Type=type logical]
                else if payload[k]="value-utf16" then [Value=Json.Document(payload[d])]
                else if payload[k]="json" then Json.Document(payload[d])
                else if payload[k]="m-time" then Time.FromText(payload[d],[Culture="en-US"])
                else if payload[k]="m-binary" then Binary.FromText(payload[d],BinaryEncoding.Hex)
                else payload[d]
        in if List.IsEmpty(matches) then Error.Record("Expression.Error",payload[m],detail) else matches{0} & [Detail=detail],
    Decode = (t,typ,encodings,aliases,rowError) =>
        let fs=Fields(typ), ns=Record.FieldNames(fs),
            ops=List.Transform(ns,(n)=>{n,(v)=>
                let encoded=Record.HasFields(encodings,n), payload=if encoded then Json.Document(v) else null,
                    value=if encoded then payload[v] else v,
                    decoded=if encoded and payload[e]<>null then error RestoreError(payload[e])
                            else if encoded and Record.Field(encodings,n)="utf16" and value<>null then Json.Document(value)
                            else if encoded and Record.Field(encodings,n)="json" and value<>null then Json.Document(value)
                            else if encoded and Record.Field(encodings,n)="logical" and value<>null then Logical.From(value)
                            else if encoded and List.Contains({"date","datetime","datetimezone"},Record.Field(encodings,n)) and value<>null then dateScalar[Decode](value,Record.Field(encodings,n))
                            else if encoded and Record.Field(encodings,n)="number" and value<>null then
                                if Text.Lower(value)="nan" then #nan else if Text.Lower(value)="inf" or Text.Lower(value)="infinity" then #infinity
                                else if Text.Lower(value)="-inf" or Text.Lower(value)="-infinity" then -#infinity
                                else if Record.FieldOrDefault(payload,"k",null)="double" then Double.From(value,"en-US") else Decimal.From(value,"en-US")
                            else value
                in decoded,Record.Field(fs,n)[Type]}),
            pairs=List.Select(List.Transform(Record.FieldNames(aliases),(n)=>{Record.Field(aliases,n),n}),each _{0}<>_{1}),
            unavailable=Table.ColumnNames(t) & ns,
            temps=List.FirstN(List.Select(List.Transform({0..List.Count(unavailable)+List.Count(pairs)},each "__pq_decode_" & Text.From(_)),each not List.Contains(unavailable,_)),List.Count(pairs)),
            checked=Table.SelectRows(t,each if Record.Field(_,rowError)=null then true else error RestoreError(Record.Field(_,rowError))),
            staged=Table.RenameColumns(checked,List.Transform(List.Positions(pairs),each {pairs{_}{0},temps{_}}),MissingField.Ignore),
            renamed=Table.RenameColumns(staged,List.Transform(List.Positions(pairs),each {temps{_},pairs{_}{1}}),MissingField.Ignore)
        in Value.ReplaceType(Table.TransformColumns(Table.SelectColumns(renamed,ns),ops),typ),
    FinalSql = (s) => "SELECT " & (if List.IsEmpty(Names(s)) then "1 AS __pq_empty_row" else Text.Combine(List.Transform(Names(s),(logical)=>let n=Physical(s,logical) in
        (if Record.HasFields(s[Encodings],logical) then
            "CAST(to_json(" & (if Record.Field(s[Encodings],logical)="utf16" then
                "struct_pack(v := CASE WHEN (" & Q(n) & ").v IS NULL THEN NULL ELSE chr(34) || coalesce(array_to_string(list_transform((" & Q(n) & ").v, x -> '\u' || lpad(to_hex(x),4,'0')),''),'') || chr(34) END, e := (" & Q(n) & ").e)"
                else Q(n)) & ") AS VARCHAR)"
         else Q(n)) & " AS " & Q(n)),", ")) &
        ", " & Q(s[RowError]) & " FROM (" & s[Sql] & ") AS q ORDER BY " & Q(s[Order]),
    Add = (s,name,fn,colType)=>            let ast=RowExpression.From(fn),node=Compile(ast,RowType(s),s[Encodings],s[Aliases]), typ=Value.Type(Table.AddColumn(#table(s[Type],{}),name,fn,colType)),physical=NewAlias(s),
                temporalKind=dateScalar[Kind](Record.FieldOrDefault(node,"Type",type any)),
                transport=s[Own] or Record.FieldOrDefault(node,"Transport",false) or temporalKind<>null,
                numeric=Type.Is(Record.FieldOrDefault(node,"Type",type any),type nullable number),
                encoding=Record.FieldOrDefault(node,"Encoding",if temporalKind<>null then temporalKind else if Type.Is(Record.FieldOrDefault(node,"Type",type any),type nullable logical) then "logical" else if numeric and Record.HasFields(node,"NumericKindSql") then "number" else "normal"),
                scalarValue=if List.Contains({"date","datetime","datetimezone"},encoding) then dateScalar[Format](node,Render) else if encoding="number" and Record.FieldOrDefault(node,"Encoding",null)<>"number" then "CAST(" & Render(node) & " AS VARCHAR)" else Render(node),
                value=if transport then "struct_pack(v := " & scalarValue & ", e := CAST(" & Record.FieldOrDefault(node,"ErrorSql","NULL") & " AS VARCHAR), k := " & Record.FieldOrDefault(node,"NumericKindSql","NULL") & ")" else Render(node),
                sql="SELECT *, " & value & " AS " & Q(physical) & " FROM (" & s[Sql] & ") AS q",
                encodings=if transport then s[Encodings] & Record.FromList({encoding},{name}) else s[Encodings]
            // Validate while the handler can still decline, before returning a
            // lazy view whose GetRows would hide the original compiler error.
            in if Text.Length(sql)<0 then error "Invalid SQL plan." else s & [Native=Table.AddColumn(s[Native],name,fn,colType),Type=typ,Sql=sql,Encodings=encodings,Aliases=s[Aliases] & Record.FromList({physical},{name}),ValueTypes=s[ValueTypes] & Record.FromList({Record.FieldOrDefault(node,"Type",colType)},{name}),Own=s[Own] or transport],
    // Owned plans already implement rows/type. A native shadow table would make
