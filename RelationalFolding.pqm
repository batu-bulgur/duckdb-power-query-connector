                sql="SELECT " & Columns(PhysicalNames(s) & {s[Order],s[RowError]}) & " FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY " & Text.Combine(List.Transform(keys,each KeySql(s,_)) & NaNKey(s,keys) & {"CASE WHEN " & Q(s[RowError]) & " IS NOT NULL THEN " & Q(s[Order]) & " ELSE 0 END"},", ") & " ORDER BY " & Q(s[Order]) & ") AS " & Q(duplicate) & " FROM (" & s[Sql] & ") AS q) AS d WHERE " & Q(duplicate) & "=1"
